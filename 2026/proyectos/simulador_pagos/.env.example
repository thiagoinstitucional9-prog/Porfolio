# Variables de entorno para el simulador de pago/cobro

# Clave secreta de Flask (generar con: python -c "import secrets; print(secrets.token_hex(16))")
SECRET_KEY=simulador-pago-cobro-desarrollo

# Configuración de la base de datos
DATABASE_URL=sqlite:///instance/app.db

# Modo de desarrollo
FLASK_ENV=development
FLASK_DEBUG=1